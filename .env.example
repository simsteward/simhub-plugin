# SimSteward plugin/dashboard environment template (cloud-only).
# Copy to ".env" for local testing only. Do NOT commit real secrets.
#
# Loaded automatically via scripts/load-dotenv.ps1 (Import-DotEnv) by:
#   deploy.ps1, watch-deploy.ps1, query-loki-once.mjs
# Use a different file: .\deploy.ps1 -EnvFile C:\path\to\secrets.env

# --- Plugin WebSocket runtime ---
SIMSTEWARD_WS_PORT=19847
SIMSTEWARD_WS_BIND=0.0.0.0
# SIMSTEWARD_WS_TOKEN=replace_me     # optional auth token for dashboard/bridge clients

# --- Session discovery ---
# SIMSTEWARD_SESSION_SNAPSHOT_AUTO=1 # auto snapshot lines on readiness changes

# --- OBS bridge (scripts/obs-bridge — currently unused; kept for future) ---
SIMSTEWARD_WS_URL=ws://127.0.0.1:19847
OBS_WS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
SEEK_BEFORE_RECORD=1
RECORD_DURATION_SEC=30

# --- Grafana Cloud Loki (logs) ---
# Cloud-only. No local Loki fallback. The Claude Code hook script and the plugin
# both push directly to this URL. Auth: Basic USER + TOKEN.
SIMSTEWARD_LOKI_URL=https://logs-prod-036.grafana.net
SIMSTEWARD_LOKI_USER=1484376
SIMSTEWARD_LOKI_TOKEN=             # glc_... — Grafana Cloud API token (Loki write scope)
SIMSTEWARD_LOG_ENV=production      # label: production | local
SIMSTEWARD_LOG_DEBUG=              # set to 1 for plugin debug mode only

# --- Grafana Cloud OTLP gateway (Claude Code native telemetry: metrics + logs) ---
# The local OTel collector (observability/local) forwards Claude Code's claude_code.cost.usage
# / token.usage metrics (incl. subagents via query_source) and claude_code.api_request logs
# here. One endpoint + one access-policy token (scopes: metrics:write, logs:write) for both.
# Find these under Grafana Cloud → Connections → OTLP. USER is the numeric OTLP instance ID.
SIMSTEWARD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
SIMSTEWARD_OTLP_USER=              # numeric OTLP instance ID
SIMSTEWARD_OTLP_TOKEN=            # glc_... — access policy token (metrics:write + logs:write)

# --- Sentry.io (errors + breadcrumbs) ---
# Plugin Init reads SIMSTEWARD_SENTRY_DSN; falls back to the hardcoded default
# (simhub-plugin project) when unset.
SIMSTEWARD_SENTRY_DSN=https://ab2d0a6f7cd97033a46f4fa7d90dabab@o4511097126780928.ingest.us.sentry.io/4511102961319936
SENTRY_AUTH_TOKEN=                 # sntrys_... — Internal Integration token (Organization:CI&Releases, Release:Admin)

# --- Grafana Cloud UI/API (read-only scripts: query-loki-once.mjs) ---
GRAFANA_URL=https://simsteward.grafana.net
GRAFANA_TOKEN=                     # glsa_... service account (DataSourceReader)
GRAFANA_DEPLOY_TOKEN=              # glsa_... service account (Editor) — dashboard write, scripts/deploy-dashboard.mjs
# GRAFANA_DASHBOARD_FOLDER_UID=    # optional: target folder for npm run dash:deploy

# --- Test harness (only when emitting test data) ---
# TEST_TAG=grafana-harness         # filter with test_tag = "grafana-harness"
