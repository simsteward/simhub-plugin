{
  "name": "sim-steward-plugin",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "SimSteward SimHub plugin (cloud-only observability via Grafana Cloud + Sentry)",
  "scripts": {
    "env:run": "dotenv -e .env --",
    "loki:query": "dotenv -e .env -- node scripts/query-loki-once.mjs",
    "dash:deploy": "dotenv -e .env -- node scripts/deploy-dashboard.mjs",
    "secrets:lint": "secretlint \"**/*\"",
    "secrets:gitleaks": "pwsh -NoProfile -File scripts/run-gitleaks-docker.ps1",
    "obs:up": "dotenv -e .env -- docker compose -f observability/local/docker-compose.yml up -d",
    "obs:down": "docker compose -f observability/local/docker-compose.yml down",
    "obs:wipe": "docker compose -f observability/local/docker-compose.yml down -v",
    "obs:ps": "docker compose -f observability/local/docker-compose.yml ps"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "dotenv-cli": "^7.4.4",
    "secretlint": "^11.4.0"
  }
}
