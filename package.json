{
  "name": "sim-steward-plugin",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "SimSteward SimHub plugin (cloud-only observability via Grafana Cloud + Sentry)",
  "scripts": {
    "env:run": "dotenv -e .env --",
    "loki:query": "dotenv -e .env -- node scripts/query-loki-once.mjs",
    "secrets:lint": "secretlint \"**/*\"",
    "secrets:gitleaks": "pwsh -NoProfile -File scripts/run-gitleaks-docker.ps1",
    "contextstream:ingest": "pwsh -NoProfile -File scripts/contextstream-ingest.ps1",
    "contextstream:ingest:force": "pwsh -NoProfile -File scripts/contextstream-ingest.ps1 -Force"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.0",
    "dotenv-cli": "^7.4.4",
    "secretlint": "^13.0.0"
  }
}
