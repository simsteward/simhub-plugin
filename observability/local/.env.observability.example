# Local observability stack environment variables example
# Copy this file to .env.observability.local and fill in values.

# Path where Loki, Grafana, and cursor-usage persistent data will be stored on the host.
# Example: S:/sim-steward-grafana-storage or C:/grafana-storage
GRAFANA_STORAGE_PATH=

# Token required by loki-gateway for pushing logs. Generate a strong token.
# Example (PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
LOKI_PUSH_TOKEN=

# Grafana login (compose substitutes into GF_SECURITY_ADMIN_*). Used only when Grafana has no DB yet.
# If you forgot the password, stop the stack, wipe the Grafana volume (npm run obs:wipe -- -Force -Grafana), then up again.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Sentinel T4 — GitHub Issue filing
# T4 auto-files GitHub Issues from high-confidence T2 findings.
# Set GITHUB_REPO to "owner/repo" (e.g. "simsteward/simhub-plugin").
# GITHUB_TOKEN must have issues:write scope. Generate at GitHub → Settings → Developer settings → PAT.
# T4 is enabled by default when these are set; omit or set SENTINEL_T4_ENABLED=false to disable.
GITHUB_REPO=
GITHUB_TOKEN=
