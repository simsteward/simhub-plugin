        "defaults": {
          "color": { "mode": "palette-classic" },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "repair_flag" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F7768E", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "furled_flag" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FF9E64", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "player_incident_count" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#7AA2F7", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "track_surface" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#BB9AF7", "mode": "fixed" } }]
          }
        ]
