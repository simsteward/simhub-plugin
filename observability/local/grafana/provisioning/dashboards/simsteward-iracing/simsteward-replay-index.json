      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
          "expr": "sum by (detection_source) (count_over_time({app=\"sim-steward\", component=\"simhub-plugin\"} | json detection_source=\"fields.detection_source\" | __error__=\"\" | event=\"replay_incident_index_detection\" [$__interval]))",
          "legendFormat": "{{detection_source}}",
          "queryType": "range",
          "refId": "A"
        }
