{
  "uid": "simsteward-replay-index",
  "title": "SimSteward — Replay Incident Index",
  "description": "Tracks replay incident index build runs: performance, detection quality, validation results, and record window activity.",
  "tags": [
    "simsteward",
    "iracing",
    "replay"
  ],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Index Build Summary",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "title": "Total Index Builds",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_local"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_local"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"replay_incident_index_fast_forward_complete\" [$__range]))",
          "legendFormat": "Builds"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#00d4aa"
              },
              {
                "value": 10,
                "color": "#ffd166"
              },
              {
                "value": 50,
                "color": "#c77dff"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Avg Build Time",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_local"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_local"
          },
          "queryType": "instant",
          "expr": "avg(avg_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"replay_incident_index_fast_forward_complete\" | json index_build_time_ms=\"fields.index_build_time_ms\" | unwrap index_build_time_ms [$__range]))",
          "legendFormat": "Avg Build Time"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#00d4aa"
              },
              {
                "value": 30000,
                "color": "#ffd166"
              },
              {
                "value": 120000,
                "color": "#f72585"
              }
            ]
          }
        },
        "overrides": []
      }
    },
