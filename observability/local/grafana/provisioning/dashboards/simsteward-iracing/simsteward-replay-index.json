{
  "uid": "simsteward-replay-index",
  "title": "SimSteward — Replay Incident Index",
  "description": "Tracks replay incident index build runs: performance, detection quality, validation results, and record window activity.",
  "tags": ["simsteward", "iracing", "replay"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Index Build Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "displayName": "Total Index Builds",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00d4aa", "value": null },
              { "color": "#ffd166", "value": 10 },
              { "color": "#c77dff", "value": 50 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
          "expr": "sum(count_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"replay_incident_index_fast_forward_complete\" [$__range]))",
          "legendFormat": "Builds",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Total Index Builds",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "displayName": "Avg Build Time",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00d4aa", "value": null },
              { "color": "#ffd166", "value": 30000 },
              { "color": "#f72585", "value": 120000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
