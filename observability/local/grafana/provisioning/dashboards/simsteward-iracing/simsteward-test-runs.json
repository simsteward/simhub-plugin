{
  "uid": "simsteward-test-runs",
  "title": "SimSteward — Test Run Results",
  "description": "SDK capture test run quality: detection rate, ground truth coverage, camera confirmation, reseek accuracy.",
  "tags": [
    "simsteward",
    "testing",
    "iracing"
  ],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 200,
      "type": "row",
      "title": "Test Run Summary",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "title": "Test Runs Completed",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_local"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_local"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_suite_complete\" [$__range]))",
          "legendFormat": "Test Runs"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#c77dff"
              },
              {
                "value": 5,
                "color": "#00d4aa"
              },
              {
                "value": 20,
                "color": "#ffd166"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Avg Detection Rate %",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_local"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_local"
          },
          "queryType": "instant",
          "expr": "avg(avg_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json detection_rate_pct=\"fields.detection_rate_pct\" | unwrap detection_rate_pct [$__range]))",
          "legendFormat": "Avg Detection %"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#f72585"
              },
              {
                "value": 60,
                "color": "#ffd166"
              },
              {
                "value": 85,
                "color": "#00d4aa"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Total GT Hits",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_local"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_local"
          },
          "queryType": "instant",
          "expr": "sum(sum_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json ground_truth_hit_count=\"fields.ground_truth_hit_count\" | unwrap ground_truth_hit_count [$__range]))",
          "legendFormat": "GT Hits"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#f72585"
              },
              {
                "value": 1,
                "color": "#ffd166"
              },
              {
                "value": 5,
                "color": "#00d4aa"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Total GT Misses",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_local"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_local"
          },
          "queryType": "instant",
          "expr": "sum(sum_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json ground_truth_miss_count=\"fields.ground_truth_miss_count\" | unwrap ground_truth_miss_count [$__range]))",
          "legendFormat": "GT Misses"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#00d4aa"
              },
              {
                "value": 1,
                "color": "#ffd166"
              },
              {
                "value": 5,
                "color": "#f72585"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 201,
      "type": "row",
      "title": "Detection Quality Over Time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 10,
      "title": "Detection Rate % by Speed",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_local"
      },
      "interval": "6h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_local"
          },
          "queryType": "range",
          "expr": "avg by (requested_speed) (avg_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json detection_rate_pct=\"fields.detection_rate_pct\", requested_speed=\"fields.requested_speed\" | unwrap detection_rate_pct [$__interval]))",
          "legendFormat": "{{requested_speed}}x speed"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 202,
      "type": "row",
      "title": "Ground Truth Hits vs Misses",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 20,
      "title": "GT Hits",
