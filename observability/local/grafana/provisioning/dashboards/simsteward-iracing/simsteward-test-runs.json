    },
    {
      "id": 203,
      "type": "row",
      "title": "Test Run Events Log",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 30,
      "title": "SDK Capture Events Log",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_local"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_local"
          },
          "expr": "{app=\"sim-steward\"} | json | __error__=\"\" | event=~\"sdk_capture_(suite_complete|suite_started|speed_sample)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      }
    }
  ]
}