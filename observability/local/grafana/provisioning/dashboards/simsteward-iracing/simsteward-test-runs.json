          },
          "queryType": "range",
          "expr": "sum(sum_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json ground_truth_miss_count=\"fields.ground_truth_miss_count\" | unwrap ground_truth_miss_count [$__interval]))",
