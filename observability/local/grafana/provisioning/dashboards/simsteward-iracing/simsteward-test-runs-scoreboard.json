    {
      "id": 10,
      "title": "T1 Detection Rate % by Speed",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki_local" },
      "interval": "6h",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki_local" },
          "queryType": "range",
          "expr": "avg(avg_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json detection_rate_pct=\"fields.detection_rate_pct\", requested_speed=\"fields.requested_speed\" | requested_speed=\"1\" | unwrap detection_rate_pct [$__interval]))",
          "legendFormat": "1x"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki_local" },
          "queryType": "range",
          "expr": "avg(avg_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json detection_rate_pct=\"fields.detection_rate_pct\", requested_speed=\"fields.requested_speed\" | requested_speed=\"4\" | unwrap detection_rate_pct [$__interval]))",
          "legendFormat": "4x"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "loki_local" },
          "queryType": "range",
          "expr": "avg(avg_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json detection_rate_pct=\"fields.detection_rate_pct\", requested_speed=\"fields.requested_speed\" | requested_speed=\"8\" | unwrap detection_rate_pct [$__interval]))",
          "legendFormat": "8x"
        },
        {
          "refId": "D",
          "datasource": { "type": "loki", "uid": "loki_local" },
          "queryType": "range",
          "expr": "avg(avg_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json detection_rate_pct=\"fields.detection_rate_pct\", requested_speed=\"fields.requested_speed\" | requested_speed=\"16\" | unwrap detection_rate_pct [$__interval]))",
          "legendFormat": "16x"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "1x" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#00d4aa" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "4x" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "8x" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#ffd166" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "16x" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }
            ]
          }
        ]
      }
