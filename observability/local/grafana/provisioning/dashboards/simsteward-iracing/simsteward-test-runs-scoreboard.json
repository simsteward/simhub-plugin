{
  "uid": "simsteward-test-runs-scoreboard",
  "title": "SimSteward — Test Runs Scoreboard",
  "description": "At-a-glance quality scoreboard across all test stages. Dense top stat row + compressed trend rows.",
  "tags": [
    "simsteward",
    "testing",
    "iracing",
    "scoreboard"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Test Run Drill-Down",
      "url": "/d/simsteward-test-runs",
      "type": "link",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [

    {
      "id": 200,
      "type": "row",
      "title": "Overall Health",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },

    {
      "id": 1,
      "title": "Runs Completed",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki_local" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki_local" },
          "queryType": "instant",
          "expr": "sum(count_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_suite_complete\" [$__range]))",
          "legendFormat": "Runs Completed"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#c77dff" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "#c77dff" }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 2,
      "title": "Cancelled %",
      "type": "stat",
      "gridPos": { "x": 3, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki_local" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki_local" },
          "queryType": "instant",
          "expr": "sum(count_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_suite_cancelled\" [$__range])) / sum(count_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_suite_started\" [$__range])) * 100",
          "legendFormat": "Cancelled %"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "#00d4aa" },
              { "value": 1,    "color": "#f72585" }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "title": "T1 Det % @1x",
      "type": "stat",
      "gridPos": { "x": 6, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki_local" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki_local" },
          "queryType": "instant",
          "expr": "avg(avg_over_time({app=\"sim-steward\"} | json | __error__=\"\" | event=\"sdk_capture_speed_sample\" | json detection_rate_pct=\"fields.detection_rate_pct\", requested_speed=\"fields.requested_speed\" | requested_speed=\"1\" | unwrap detection_rate_pct [$__range]))",
          "legendFormat": "T1 Det% @1x"
        }
      ],
      "options": {
        "colorMode": "background-gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "#f72585" },
              { "value": 60,   "color": "#ffd166" },
              { "value": 85,   "color": "#00d4aa" }
            ]
          }
        },
        "overrides": []
      }
    },

