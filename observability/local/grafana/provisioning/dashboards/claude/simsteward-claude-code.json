{
  "uid": "simsteward-claude-code",
  "title": "SimSteward — Claude Code",
  "description": "Claude Code session cost, token usage, tool health, and session audit",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 2,
  "tags": ["claude", "sim-steward", "cost"],
  "timezone": "browser",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "label": "Environment",
        "query": "dev,local,production",
        "current": {"selected": true, "text": "dev", "value": "dev"},
        "allValue": ".*",
        "includeAll": true,
        "multi": false,
        "hide": 0,
        "skipUrlSync": false,
        "options": [
          {"selected": true, "text": "dev", "value": "dev"},
          {"selected": false, "text": "local", "value": "local"},
          {"selected": false, "text": "production", "value": "production"}
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "Cost Summary",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false, "panels": []
    },
    {
      "type": "stat", "title": "Total Cost",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "decimals": 2, "color": {"fixedColor": "#7AA2F7", "mode": "fixed"}, "noValue": "$0.00"},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap cost_usd [$__range]))", "legendFormat": "Total Cost", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Cache Savings",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "decimals": 2, "color": {"fixedColor": "#9ECE6A", "mode": "fixed"}, "noValue": "$0.00"},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap cache_savings_usd [$__range]))", "legendFormat": "Cache Savings", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Cache Hit Rate",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "decimals": 1, "color": {"mode": "thresholds"}, "noValue": "0%", "thresholds": {"mode": "absolute", "steps": [{"color": "#F7768E", "value": null}, {"color": "#E0AF68", "value": 0.3}, {"color": "#9ECE6A", "value": 0.6}]}},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_cache_read_tokens [$__range])) / (sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_input_tokens [$__range])) + sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_cache_read_tokens [$__range])) + sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_cache_creation_tokens [$__range])))", "legendFormat": "Cache Hit Rate", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Tool Errors",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#E0AF68", "value": 1}, {"color": "#F7768E", "value": 5}]}},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(count_over_time({app=\"claude-dev-logging\", env=~\"$env\", level=\"ERROR\"} [$__range]))", "legendFormat": "Tool Errors", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "row", "title": "Monthly Limit Tracker",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false, "panels": []
    },
    {
      "type": "stat", "title": "Monthly Spend % of $100 Limit (set range to now-30d)",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "decimals": 1, "min": 0, "max": 1, "displayName": "30-Day Spend", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#E0AF68", "value": 0.6}, {"color": "#F7768E", "value": 0.85}]}},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap cost_usd [$__range])) / 100", "legendFormat": "Monthly Spend %", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "row", "title": "Cost Trend",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "collapsed": false, "panels": []
    },
    {
      "type": "timeseries", "title": "Cost per Turn — Breakdown",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15},
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "custom": {"fillOpacity": 70, "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Output Cost"}, "properties": [{"id": "color", "value": {"fixedColor": "#F7768E", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Input Cost"}, "properties": [{"id": "color", "value": {"fixedColor": "#7AA2F7", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Cache Write Cost"}, "properties": [{"id": "color", "value": {"fixedColor": "#E0AF68", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Cache Read Cost"}, "properties": [{"id": "color", "value": {"fixedColor": "#9ECE6A", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap output_cost_usd [$__interval]))", "legendFormat": "Output Cost", "queryType": "range", "refId": "A"},
        {"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap input_cost_usd [$__interval]))", "legendFormat": "Input Cost", "queryType": "range", "refId": "B"},
        {"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap cache_write_cost_usd [$__interval]))", "legendFormat": "Cache Write Cost", "queryType": "range", "refId": "C"},
        {"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap cache_read_cost_usd [$__interval]))", "legendFormat": "Cache Read Cost", "queryType": "range", "refId": "D"}
      ]
    },
    {
      "type": "row", "title": "Token Volume",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "collapsed": false, "panels": []
    },
    {
      "type": "timeseries", "title": "Token Volume per Turn",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"fillOpacity": 70, "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Output Tokens"}, "properties": [{"id": "color", "value": {"fixedColor": "#FF9E64", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Input Tokens"}, "properties": [{"id": "color", "value": {"fixedColor": "#7AA2F7", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Cache Write Tokens"}, "properties": [{"id": "color", "value": {"fixedColor": "#E0AF68", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Cache Read Tokens"}, "properties": [{"id": "color", "value": {"fixedColor": "#9ECE6A", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_output_tokens [$__interval]))", "legendFormat": "Output Tokens", "queryType": "range", "refId": "A"},
        {"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_input_tokens [$__interval]))", "legendFormat": "Input Tokens", "queryType": "range", "refId": "B"},
        {"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_cache_creation_tokens [$__interval]))", "legendFormat": "Cache Write Tokens", "queryType": "range", "refId": "C"},
        {"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_cache_read_tokens [$__interval]))", "legendFormat": "Cache Read Tokens", "queryType": "range", "refId": "D"}
      ]
    },
    {
      "type": "row", "title": "Tool Health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32},
      "collapsed": false, "panels": []
    },
    {
      "type": "bargauge", "title": "Slowest Tools — Avg Duration (ms)",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 33},
      "fieldConfig": {
        "defaults": {"unit": "ms", "color": {"mode": "continuous-BlYlRd"}, "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#E0AF68", "value": 5000}, {"color": "#F7768E", "value": 30000}]}},
        "overrides": []
      },
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["mean"], "fields": "", "values": false}, "text": {}, "tooltip": {"mode": "single"}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "avg by (tool_name) (avg_over_time({app=\"claude-dev-logging\", env=~\"$env\"} | json | __error__=\"\" | hook_type=\"post-tool-use\" | duration_ms > 0 | unwrap duration_ms [$__range]))", "legendFormat": "{{tool_name}}", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Tool Errors (Range)",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 33},
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#F7768E", "value": 1}]}},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(count_over_time({app=\"claude-dev-logging\", env=~\"$env\", level=\"ERROR\"} [$__range]))", "legendFormat": "Errors", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Retries",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 33},
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#E0AF68", "value": 5}, {"color": "#F7768E", "value": 20}]}},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(count_over_time({app=\"claude-dev-logging\", env=~\"$env\", component=\"tool\"} | json | __error__=\"\" | is_retry=\"true\" [$__range]))", "legendFormat": "Retries", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Avg Tool Time / Turn (ms)",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 38},
      "fieldConfig": {
        "defaults": {"unit": "ms", "decimals": 0, "color": {"fixedColor": "#7DCFFF", "mode": "fixed"}, "noValue": "0"},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "avg(avg_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | tool_time_ms > 0 | unwrap tool_time_ms [$__range]))", "legendFormat": "Avg Tool Time", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Total Tool Calls",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 38},
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0, "color": {"fixedColor": "#BB9AF7", "mode": "fixed"}, "noValue": "0"},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(count_over_time({app=\"claude-dev-logging\", env=~\"$env\", component=\"tool\"} | json | __error__=\"\" | hook_type=\"post-tool-use\" [$__range]))", "legendFormat": "Tool Calls", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "row", "title": "Session Audit",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 43},
      "collapsed": false, "panels": []
    },
    {
      "type": "logs", "title": "Session Summaries",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 44},
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "{app=\"claude-dev-logging\", env=~\"$env\", component=\"lifecycle\"} | json | __error__=\"\" | event=\"claude_session_summary\"", "legendFormat": "", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "logs", "title": "Raw Logs — claude-dev-logging",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 54},
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "{app=\"claude-dev-logging\", env=~\"$env\"}", "legendFormat": "", "queryType": "range", "refId": "A"}]
    }
  ]
}
