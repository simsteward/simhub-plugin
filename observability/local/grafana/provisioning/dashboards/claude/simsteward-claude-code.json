{
  "uid": "simsteward-claude-code",
  "title": "SimSteward — Claude Code",
  "description": "Claude Code usage. TOP section = OTel-native metrics (claude_code.cost.usage / claude_code.token.usage) via Grafana Cloud Mimir — live since 2026-07-18; no data before that date (see docs/GRAFANA-LOGGING.md). BOTTOM = legacy Loki hook-pipeline cross-check + tool health + session audit (no Mimir equivalent for these). Subscription 5h/weekly limit % is NOT available via telemetry — see the Spend Context note.",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 4,
  "tags": ["claude", "sim-steward", "cost", "otel"],
  "timezone": "browser",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "label": "Environment",
        "query": "dev,local,production",
        "current": {"selected": true, "text": "dev", "value": "dev"},
        "allValue": ".*",
        "includeAll": true,
        "multi": false,
        "hide": 0,
        "skipUrlSync": false,
        "options": [
          {"selected": true, "text": "dev", "value": "dev"},
          {"selected": false, "text": "local", "value": "local"},
          {"selected": false, "text": "production", "value": "production"}
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "All Sources — cost & tokens (OTel / Mimir, live)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false, "panels": []
    },
    {
      "type": "stat", "title": "Total Cost",
      "description": "Sum of claude_code.cost.usage across main sessions, subagents, and auxiliary requests. OTel-native (Mimir) — replaces the Loki hook-pipeline estimate.",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 2, "color": {"fixedColor": "#7AA2F7", "mode": "fixed"}, "noValue": "$0.00"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum(increase({__name__=~\"claude_code_cost_usage.*\", env=~\"$env\"}[$__range]))", "legendFormat": "Total Cost", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Total Tokens",
      "description": "Total tokens (input+output+cacheRead+cacheCreation) across main sessions, subagents, and auxiliary requests. OTel-native (Mimir).",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 1, "color": {"fixedColor": "#BB9AF7", "mode": "fixed"}, "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum(increase({__name__=~\"claude_code_token_usage.*\", env=~\"$env\"}[$__range]))", "legendFormat": "Total Tokens", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Subagent Share",
      "description": "Fraction of total cost where query_source=subagent. Excludes query_source=auxiliary from the numerator (auxiliary is a separate, third category — see Cost by Source below), but auxiliary is still included in the denominator.",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "min": 0, "max": 1, "color": {"mode": "thresholds"}, "noValue": "0%", "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#E0AF68", "value": 0.4}, {"color": "#7AA2F7", "value": 0.7}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum(increase({__name__=~\"claude_code_cost_usage.*\", env=~\"$env\", query_source=\"subagent\"}[$__range])) / sum(increase({__name__=~\"claude_code_cost_usage.*\", env=~\"$env\"}[$__range]))", "legendFormat": "Subagent %", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Subagent Cost",
      "description": "Absolute cost where query_source=subagent. OTel-native (Mimir) — live, not backfilled.",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 2, "color": {"fixedColor": "#7DCFFF", "mode": "fixed"}, "noValue": "$0.00"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum(increase({__name__=~\"claude_code_cost_usage.*\", env=~\"$env\", query_source=\"subagent\"}[$__range]))", "legendFormat": "Subagent Cost", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Cost by Source (main / subagent / auxiliary)",
      "description": "Cost split by query_source. OTel-native (Mimir) — auxiliary is a genuine third category (see docs/GRAFANA-LOGGING.md), not folded into subagent. Query has a 15m minimum step so thin categories (auxiliary is sparse — occasional requests) reliably get >=2 samples per bucket and survive increase(); without this, a series with very few raw samples can silently vanish from the legend even though it has real, non-zero total cost.",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "custom": {"fillOpacity": 70, "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum by (query_source) (increase({__name__=~\"claude_code_cost_usage.*\", env=~\"$env\"}[$__interval]))", "legendFormat": "{{query_source}}", "queryType": "range", "refId": "A", "interval": "15m"}]
    },
    {
      "type": "piechart", "title": "Cost Share by Model",
      "description": "Cost breakdown by model. OTel-native (Mimir).",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "pieType": "donut", "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false}, "tooltip": {"mode": "single"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum by (model) (increase({__name__=~\"claude_code_cost_usage.*\", env=~\"$env\"}[$__range]))", "legendFormat": "{{model}}", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Tokens by Type",
      "description": "Token breakdown: input, output, cacheRead, cacheCreation. OTel-native (Mimir) — label values are claude_code_token_usage_tokens_total's own type attribute, camelCase.",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 70, "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum by (type) (increase({__name__=~\"claude_code_token_usage.*\", env=~\"$env\"}[$__interval]))", "legendFormat": "{{type}}", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Cost by Model",
      "description": "Cost over time broken down by model. OTel-native (Mimir).",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "custom": {"fillOpacity": 70, "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum by (model) (increase({__name__=~\"claude_code_cost_usage.*\", env=~\"$env\"}[$__interval]))", "legendFormat": "{{model}}", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "row", "title": "Spend Context — API-equivalent (NOT subscription plan-limit)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 21},
      "collapsed": false, "panels": []
    },
    {
      "type": "stat", "title": "API-equivalent Spend (selected range)",
      "description": "Retail API-price equivalent of usage in the selected range. A volume/cost proxy — NOT your subscription plan-limit usage. OTel-native (Mimir).",
      "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 22},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 2, "color": {"fixedColor": "#7AA2F7", "mode": "fixed"}, "noValue": "$0.00"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "grafanacloud-prom"}, "expr": "sum(increase({__name__=~\"claude_code_cost_usage.*\", env=~\"$env\"}[$__range]))", "legendFormat": "Spend", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "text", "title": "Why there is no plan-limit gauge",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22},
      "options": {"mode": "markdown", "content": "**This dashboard tracks cost & token *volume*, not subscription limits.**\n\nThe 5-hour session % and weekly % shown in `/status` and `/usage` are **subscription rate-limit windows computed client-side** by Claude Code. They are **not exposed** via OpenTelemetry metrics, hook payloads, or any feed this stack can read.\n\nThe old *\"Monthly Spend % of $100\"* gauge divided API-retail cost by a dollar limit that does not apply to a subscription plan — it was removed. The stat at left is the API-equivalent spend (a useful volume proxy), nothing more.\n\nSee `docs/GRAFANA-LOGGING.md` → *Claude Code native telemetry*."}
    },
    {
      "type": "row", "title": "Legacy — Hook Pipeline (Loki) · main-session live + backfilled subagents",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28},
      "collapsed": false, "panels": []
    },
    {
      "type": "stat", "title": "Total Cost (hook pipeline — cross-check)",
      "description": "Per-turn cost_usd from the Loki hook pipeline (main session live; subagents only after running scripts/backfill-subagent-usage.js). Cross-check against the authoritative metric above — expect these two numbers to differ, typically by 20-35%, not match exactly. This panel estimates cache-write cost with a flat multiplier (scripts/hooks/loki-log.js MODEL_PRICING) because the transcript doesn't record which cache TTL tier (5-min vs 1-hour, priced differently) each write used; the Total Cost panel above reflects Claude Code's own native OTel cost accounting and is the more accurate figure. If this number is ever $0.00 or wildly larger than 2x the Total Cost panel, that's a real bug (e.g. an unpriced model — check the claude-dev-logging stream for a pricing_unknown_model WARN), not the expected estimation variance.",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 29},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 2, "color": {"fixedColor": "#565f89", "mode": "fixed"}, "noValue": "$0.00"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap cost_usd [$__range]))", "legendFormat": "Total Cost", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Cache Savings",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 29},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 2, "color": {"fixedColor": "#9ECE6A", "mode": "fixed"}, "noValue": "$0.00"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap cache_savings_usd [$__range]))", "legendFormat": "Cache Savings", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Cache Hit Rate",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 29},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "color": {"mode": "thresholds"}, "noValue": "0%", "thresholds": {"mode": "absolute", "steps": [{"color": "#F7768E", "value": null}, {"color": "#E0AF68", "value": 0.3}, {"color": "#9ECE6A", "value": 0.6}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_cache_read_tokens [$__range])) / (sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_input_tokens [$__range])) + sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_cache_read_tokens [$__range])) + sum(sum_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | event=\"claude_turn_metrics\" | unwrap total_cache_creation_tokens [$__range])))", "legendFormat": "Cache Hit Rate", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Tool Errors",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 29},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#E0AF68", "value": 1}, {"color": "#F7768E", "value": 5}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(count_over_time({app=\"claude-dev-logging\", env=~\"$env\", level=\"ERROR\"} [$__range]))", "legendFormat": "Tool Errors", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "row", "title": "Tool Health (Hook Pipeline)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33},
      "collapsed": false, "panels": []
    },
    {
      "type": "bargauge", "title": "Slowest Tools — Avg Duration (ms)",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 34},
      "fieldConfig": {"defaults": {"unit": "ms", "color": {"mode": "continuous-BlYlRd"}, "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#E0AF68", "value": 5000}, {"color": "#F7768E", "value": 30000}]}}, "overrides": []},
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["mean"], "fields": "", "values": false}, "text": {}, "tooltip": {"mode": "single"}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "avg by (tool_name) (avg_over_time({app=\"claude-dev-logging\", env=~\"$env\"} | json | __error__=\"\" | hook_type=\"post-tool-use\" | duration_ms > 0 | unwrap duration_ms [$__range]))", "legendFormat": "{{tool_name}}", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Tool Errors (Range)",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 34},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#F7768E", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(count_over_time({app=\"claude-dev-logging\", env=~\"$env\", level=\"ERROR\"} [$__range]))", "legendFormat": "Errors", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Retries",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 34},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "#9ECE6A", "value": null}, {"color": "#E0AF68", "value": 5}, {"color": "#F7768E", "value": 20}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(count_over_time({app=\"claude-dev-logging\", env=~\"$env\", component=\"tool\"} | json | __error__=\"\" | is_retry=\"true\" [$__range]))", "legendFormat": "Retries", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Avg Tool Time / Turn (ms)",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 39},
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 0, "color": {"fixedColor": "#7DCFFF", "mode": "fixed"}, "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "avg(avg_over_time({app=\"claude-token-metrics\", env=~\"$env\"} | json | __error__=\"\" | tool_time_ms > 0 | unwrap tool_time_ms [$__range]))", "legendFormat": "Avg Tool Time", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Total Tool Calls",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 39},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"fixedColor": "#BB9AF7", "mode": "fixed"}, "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "sum(count_over_time({app=\"claude-dev-logging\", env=~\"$env\", component=\"tool\"} | json | __error__=\"\" | hook_type=\"post-tool-use\" [$__range]))", "legendFormat": "Tool Calls", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "row", "title": "Session Audit",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 44},
      "collapsed": false, "panels": []
    },
    {
      "type": "logs", "title": "Session Summaries",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 45},
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "{app=\"claude-dev-logging\", env=~\"$env\", component=\"lifecycle\"} | json | __error__=\"\" | event=\"claude_session_summary\"", "legendFormat": "", "queryType": "range", "refId": "A"}]
    },
    {
      "type": "logs", "title": "Raw Logs — claude-dev-logging",
      "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 55},
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false},
      "targets": [{"datasource": {"type": "loki", "uid": "grafanacloud-logs"}, "expr": "{app=\"claude-dev-logging\", env=~\"$env\"}", "legendFormat": "", "queryType": "range", "refId": "A"}]
    }
  ]
}
